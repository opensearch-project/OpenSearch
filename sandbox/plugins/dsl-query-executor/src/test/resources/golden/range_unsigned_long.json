    "    LogicalTableScan(table=[[test-index]])"
  ],
  "mockResultFieldNames": [
    "name",
    "counter",
    "_id"
  ],
  "mockResultRows": [
    [
      "item1",
      500,
      "id-1"
    ]
  ],
  "expectedOutputDsl": {
    "num_reduce_phases": 0,
    "hits": {
      "total": {
        "value": 1,
        "relation": "eq"
      },
      "max_score": null,
      "hits": [
        {
          "_score": null,
          "_source": {
            "name": "item1",
            "counter": 500
          },
          "_id": "id-1"
        }
      ]
    }
  }
