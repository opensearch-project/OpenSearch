{
  "testName": "regexp_query_flags_hits",
  "indexName": "test-index",
  "indexMapping": {
    "name": "VARCHAR",
    "price": "INTEGER",
    "brand": "VARCHAR",
    "rating": "DOUBLE"
  },
  "planType": "HITS",
  "inputDsl": {
    "query": {
      "regexp": {
        "name": {
          "value": "lap.*",
          "flags": "COMPLEMENT|INTERVAL"
        }
      }
    }
  },
  "expectedRelNodePlan": [
    "LogicalFilter(condition=[REGEXP_QUERY(MAP('field', $0), MAP('query', 'lap.*'), MAP('flags', '65568'))])",
    "  LogicalTableScan(table=[[test-index]])"
  ],
  "mockResultFieldNames": ["name", "price", "brand", "rating"],
  "mockResultRows": [
    ["laptop", 999, "BrandA", 4.5]
  ],
  "expectedOutputDsl": {
    "num_reduce_phases": 0,
    "hits": {
      "total": {
        "value": 0,
        "relation": "eq"
      },
      "max_score": 0.0,
      "hits": []
    }
  }
}
