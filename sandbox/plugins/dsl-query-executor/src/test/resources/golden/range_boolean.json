{
  "testName": "range_boolean",
  "indexName": "test-index",
  "indexMapping": {
    "name": "VARCHAR",
    "is_active": "BOOLEAN"
  },
  "planType": "HITS",
  "inputDsl": {
    "query": {
      "range": {
        "is_active": {
          "gte": true,
          "lte": true
        }
      }
    }
  },
  "expectedRelNodePlan": [
    "LogicalSort(fetch=[10])",
    "  LogicalFilter(condition=[AND(>=($1, CAST(true):BOOLEAN), <=($1, CAST(true):BOOLEAN))])",
    "    LogicalTableScan(table=[[test-index]])"
  ],
  "mockResultFieldNames": [
    "name",
    "is_active",
    "_id"
  ],
  "mockResultRows": [
    [
      "product1",
      true,
      "id-1"
    ]
  ],
  "expectedOutputDsl": {
    "num_reduce_phases": 0,
    "hits": {
      "total": {
        "value": 1,
        "relation": "eq"
      },
      "max_score": null,
      "hits": [
        {
          "_score": null,
          "_source": {
            "name": "product1",
            "is_active": true
          },
          "_id": "id-1"
        }
      ]
    }
  }
}
