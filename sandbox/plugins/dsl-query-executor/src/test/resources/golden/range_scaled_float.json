  "expectedRelNodePlan": [
    "LogicalFilter(condition=[AND(>=($1, CAST(150:SCALED_FLOAT(100.0)):SCALED_FLOAT(100.0)), <=($1, CAST(950:SCALED_FLOAT(100.0)):SCALED_FLOAT(100.0)))])",
    "  LogicalTableScan(table=[[test-index]])"
  ],
  "mockResultFieldNames": ["name", "price"],
  "mockResultRows": [
    ["item1", 150]
  ],
  "expectedOutputDsl": {
    "num_reduce_phases": 0,
    "hits": {
      "total": {
        "value": 0,
        "relation": "eq"
      },
      "max_score": 0.0,
      "hits": []
    }
  }
}
