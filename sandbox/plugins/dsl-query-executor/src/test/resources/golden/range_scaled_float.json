{
  "testName": "range_scaled_float",
  "indexName": "test-index",
  "indexMapping": {
    "name": "VARCHAR",
    "price": "SCALED_FLOAT(100)"
  },
  "planType": "HITS",
  "inputDsl": {
    "query": {
      "range": {
        "price": {
          "gte": 1.5,
          "lte": 9.5
