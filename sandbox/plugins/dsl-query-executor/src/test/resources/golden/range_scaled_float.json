{
  "testName": "range_scaled_float",
  "indexName": "test-index",
  "indexMapping": {
    "name": "VARCHAR",
    "price": "SCALED_FLOAT(100)"
  },
  "planType": "HITS",
  "inputDsl": {
    "query": {
      "range": {
        "price": {
          "gte": 1.5,
          "lte": 9.5
        }
      }
    }
  },
  "expectedRelNodePlan": [
    "LogicalSort(fetch=[10])",
    "  LogicalFilter(condition=[AND(>=($1, CAST(150:SCALED_FLOAT(100.0)):SCALED_FLOAT(100.0)), <=($1, CAST(950:SCALED_FLOAT(100.0)):SCALED_FLOAT(100.0)))])",
    "    LogicalTableScan(table=[[test-index]])"
  ],
  "mockResultFieldNames": [
    "name",
    "price",
    "_id"
  ],
  "mockResultRows": [
    [
      "item1",
      150,
      "id-1"
    ]
  ],
  "expectedOutputDsl": {
    "num_reduce_phases": 0,
    "hits": {
      "total": {
        "value": 1,
        "relation": "eq"
      },
      "max_score": null,
      "hits": [
        {
          "_score": null,
          "_source": {
            "name": "item1",
            "price": 150
          },
          "_id": "id-1"
        }
      ]
    }
  }
}
