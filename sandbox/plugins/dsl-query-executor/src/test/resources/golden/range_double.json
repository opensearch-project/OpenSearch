{
  "testName": "range_double",
  "indexName": "test-index",
  "indexMapping": {
    "name": "VARCHAR",
    "rating": "DOUBLE"
  },
  "planType": "HITS",
  "inputDsl": {
    "query": {
      "range": {
        "rating": {
          "gte": 3.5,
          "lte": 9.5
        }
      }
    }
  },
  "expectedRelNodePlan": [
    "LogicalSort(fetch=[10])",
    "  LogicalFilter(condition=[AND(>=($1, CAST(3.5E0:DOUBLE):DOUBLE), <=($1, CAST(9.5E0:DOUBLE):DOUBLE))])",
    "    LogicalTableScan(table=[[test-index]])"
  ],
  "mockResultFieldNames": [
    "name",
    "rating",
    "_id"
  ],
  "mockResultRows": [
    [
      "item1",
      4.5,
      "id-1"
    ]
  ],
  "expectedOutputDsl": {
    "num_reduce_phases": 0,
    "hits": {
      "total": {
        "value": 1,
        "relation": "eq"
      },
      "max_score": null,
      "hits": [
        {
          "_score": null,
          "_source": {
            "name": "item1",
            "rating": 4.5
          },
          "_id": "id-1"
        }
      ]
    }
  }
}
