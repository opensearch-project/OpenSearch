{
  "testName": "range_double",
  "indexName": "test-index",
  "indexMapping": {
    "name": "VARCHAR",
    "rating": "DOUBLE"
  },
  "planType": "HITS",
  "inputDsl": {
    "query": {
      "range": {
        "rating": {
          "gte": 3.5,
          "lte": 9.5
        }
      }
    }
