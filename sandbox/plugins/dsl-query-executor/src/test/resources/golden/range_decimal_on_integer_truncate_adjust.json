{
  "testName": "range_decimal_on_integer_truncate_adjust",
  "indexName": "test-index",
  "indexMapping": {
    "name": "VARCHAR",
    "price": "INTEGER",
    "brand": "VARCHAR",
    "rating": "DOUBLE"
  },
  "planType": "HITS",
  "inputDsl": {
    "query": {
      "range": {
        "price": {
          "gte": 10.5,
          "lte": 99.7
        }
      }
    }
  },
  "expectedRelNodePlan": [
    "LogicalSort(fetch=[10])",
    "  LogicalFilter(condition=[AND(>=($1, CAST(11):INTEGER), <=($1, CAST(99):INTEGER))])",
    "    LogicalTableScan(table=[[test-index]])"
  ],
  "mockResultFieldNames": [
    "name",
    "price",
    "brand",
    "rating",
    "_id"
  ],
  "mockResultRows": [
    [
      "laptop",
      999,
      "BrandA",
      4.5,
      "id-1"
    ],
    [
      "phone",
      699,
      "BrandB",
      4.2,
      "id-2"
    ]
  ],
  "expectedOutputDsl": {
    "num_reduce_phases": 0,
    "hits": {
      "total": {
        "value": 2,
        "relation": "eq"
      },
      "max_score": null,
      "hits": [
        {
          "_score": null,
          "_source": {
            "name": "laptop",
            "price": 999,
            "brand": "BrandA",
            "rating": 4.5
          },
          "_id": "id-1"
        },
        {
          "_score": null,
          "_source": {
            "name": "phone",
            "price": 699,
            "brand": "BrandB",
            "rating": 4.2
          },
          "_id": "id-2"
        }
      ]
    }
  }
}
