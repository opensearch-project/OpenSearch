{
  "testName": "prefix_query_hits",
  "indexName": "test-index",
  "indexMapping": {
    "name": "VARCHAR",
    "price": "INTEGER"
  },
  "planType": "HITS",
  "inputDsl": {
    "query": {
      "prefix": {
        "name": {
          "value": "lap"
        }
      }
    }
  },
  "expectedRelNodePlan": [
    "LogicalSort(fetch=[10])",
    "  LogicalFilter(condition=[PREFIX_QUERY(MAP('field', $0), MAP('query', 'lap'))])",
    "    LogicalTableScan(table=[[test-index]])"
  ],
  "mockResultFieldNames": ["name", "price", "_id"],
  "mockResultRows": [
    ["laptop", 999, "id-1"],
    ["laptop_pro", 1499, "id-2"]
  ],
  "expectedOutputDsl": {
    "num_reduce_phases": 0,
    "hits": {
      "total": {
        "value": 2,
        "relation": "eq"
      },
      "max_score": null,
      "hits": [
        {
          "_source": {
            "name": "laptop",
            "price": 999
          },
          "_score": null,
          "_id": "id-1"
        },
        {
          "_source": {
            "name": "laptop_pro",
            "price": 1499
          },
          "_score": null,
          "_id": "id-2"
        }
      ]
    }
  }
}
