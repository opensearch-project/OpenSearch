<!--
  License definitions for the licenseHeaders precommit task. Keeping these out of the
  build code means the same definitions can be used by the Rat command line or any other
  Rat UI. See LicenseHeadersTask for the code that reads this file.

  Note that families listed under <approved> are the only ones accepted. BSD4 is defined
  but deliberately left unapproved so that BSD 4-clause code is reported if it ever shows up.
-->
<rat-config>
    <families>
        <family id="AL" name="Apache" />
        <family id="SPDX" name="SPDX" />
        <family id="GEN" name="Generated" />
        <family id="VEN" name="Vendored" />
        <family id="BSD4" name="Original BSD License (with advertising clause)" />
    </families>
    <licenses>
        <license family="AL" id="AL-ES" name="Apache License 2.0 (Elasticsearch)">
            <note>Apache license header inherited from Elasticsearch.</note>
            <text>Licensed to Elasticsearch under one or more contributor</text>
        </license>

        <license family="SPDX" id="SPDX-OS" name="SPDX (OpenSearch)">
            <note>The standard OpenSearch header.</note>
            <any>
                <text>SPDX-License-Identifier: Apache-2.0</text>
                <text>Copyright OpenSearch Contributors.</text>
            </any>
        </license>

        <license family="GEN" id="GEN-ANTLR" name="Generated">
            <note>Parsers generated by antlr.</note>
            <text>ANTLR GENERATED CODE</text>
        </license>

        <license family="VEN" id="VEN-NOTICE" name="Vendored">
            <note>Vendored code, whose license is recorded in a @notice block.</note>
            <text>@notice</text>
        </license>

        <!--
          BSD 4-clause is never approved. It is defined here so that if someone ever adds
          BSD 4-clause code it is identified as such rather than merely being unknown.
        -->
        <license family="BSD4" id="BSD4-ADV" name="Original BSD License (with advertising clause)">
            <text>All advertising materials</text>
        </license>
    </licenses>
    <approved>
        <family license_ref="AL" />
        <family license_ref="SPDX" />
        <family license_ref="GEN" />
        <family license_ref="VEN" />
    </approved>
    <matchers>
        <matcher class="org.apache.rat.configuration.builders.AllBuilder" />
        <matcher class="org.apache.rat.configuration.builders.AnyBuilder" />
        <matcher class="org.apache.rat.configuration.builders.CopyrightBuilder" />
        <matcher class="org.apache.rat.configuration.builders.MatcherRefBuilder" />
        <matcher class="org.apache.rat.configuration.builders.NotBuilder" />
        <matcher class="org.apache.rat.configuration.builders.RegexBuilder" />
        <matcher class="org.apache.rat.configuration.builders.SpdxBuilder" />
        <matcher class="org.apache.rat.configuration.builders.TextBuilder" />
    </matchers>
</rat-config>
